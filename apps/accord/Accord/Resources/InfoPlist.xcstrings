    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accord uses Face ID to unlock your formula book when App Lock is on."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 App 鎖定時，Accord 會用 Face ID 解鎖你的配方本。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启 App 锁定时，Accord 会用 Face ID 解锁你的配方本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリロックがオンのとき、Accord は Face ID で処方ノートのロックを解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 잠금이 켜져 있으면 Accord가 Face ID로 조향 노트를 잠금 해제합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die App-Sperre aktiv ist, entsperrt Accord dein Rezeptbuch mit Face ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le verrouillage est activé, Accord utilise Face ID pour ouvrir votre carnet de formules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el bloqueo está activado, Accord usa Face ID para abrir tu libro de fórmulas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o bloqueio está ativado, o Accord usa o Face ID para abrir seu caderno de fórmulas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando il blocco è attivo, Accord usa Face ID per sbloccare il tuo quaderno di formule."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accord saves the share card you create to your photo library."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Accord 會把你製作的分享卡存到照片圖庫。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Accord 会把你制作的分享卡存到照片图库。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成したシェアカードを写真ライブラリに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Accord가 만든 공유 카드를 사진 보관함에 저장합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Accord speichert die erstellte Teilkarte in deiner Fotomediathek."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accord enregistre la carte créée dans votre photothèque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accord guarda la tarjeta que creas en tu fototeca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Accord salva o cartão criado na sua fototeca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accord salva la scheda creata nella tua libreria foto."
          }
        }
      }
    }
  },
  "version": "1.0"
}