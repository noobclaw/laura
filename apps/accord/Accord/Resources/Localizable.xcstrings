    "Add your first material. Type grams, drops or a percentage, whichever you weigh in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your first material. Type grams, drops or a percentage, whichever you weigh in."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入第一種原料。用你習慣的單位輸入：克、滴或百分比。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
