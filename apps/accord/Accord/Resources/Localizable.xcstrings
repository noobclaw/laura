          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原料ごとの残量・グラム単価・使用期限・仕入れ先を管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원료마다 남은 그램, g당 원가, 보관 기한, 공급업체를 관리하세요."
