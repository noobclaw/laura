    "Start a formula and add materials by gram, drop or percent. Accord does the arithmetic.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a formula and add materials by gram, drop or percent. Accord does the arithmetic."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始一個配方，用克、滴或百分比加入原料，計算交給 Accord。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始一个配方，用克、滴或百分比加入原料，计算交给 Accord。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処方を始めて、グラム・滴・% で原料を加えましょう。計算は Accord がします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처방을 시작하고 그램, 방울, 퍼센트로 원료를 추가하세요. 계산은 Accord가 합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne ein Rezept und füge Rohstoffe in Gramm, Tropfen oder Prozent hinzu. Accord rechnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez une formule et ajoutez des matières en grammes, gouttes ou pourcentage. Accord fait les calculs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza una fórmula y añade materiales por gramo, gota o porcentaje. Accord hace las cuentas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece uma fórmula e adicione materiais por grama, gota ou porcentagem. O Accord faz as contas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia una formula e aggiungi materiali in grammi, gocce o percentuale. Accord fa i conti."
          }
        }
      }
    },
