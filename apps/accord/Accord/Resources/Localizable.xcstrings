          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du gewogen hast und wie es an Tag 7, 14 und 28 roch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez pesé, et son odeur aux jours 7, 14 et 28."
          }
        },
