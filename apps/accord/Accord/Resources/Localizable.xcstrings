    "Imported a formula with %1$lld lines (%2$lld new materials). It’s on your bench.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported a formula with %1$lld lines (%2$lld new materials). It’s on your bench."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已匯入一個 %1$lld 行的配方（新增 %2$lld 種原料），已放在調香台上。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已导入一个 %1$lld 行的配方（新增 %2$lld 种原料），已放在调香台上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 行の処方を読み込みました（新しい原料 %2$lld 件）。調香台に出しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld줄 처방을 가져왔습니다(새 원료 %2$lld종). 조향대에 올려 두었습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezept mit %1$lld Zeilen importiert (%2$lld neue Rohstoffe). Es liegt auf deiner Werkbank."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Formule de %1$lld lignes importée (%2$lld nouvelles matières). Elle est sur votre orgue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fórmula de %1$lld líneas importada (%2$lld materiales nuevos). Está en tu mesa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fórmula com %1$lld linhas importada (%2$lld materiais novos). Está na sua bancada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Formula di %1$lld righe importata (%2$lld nuovi materiali). È sul tuo banco."
          }
        }
      }
    },
