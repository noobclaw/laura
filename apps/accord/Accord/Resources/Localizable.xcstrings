    "Your formulas live here as bottles, filled with their top, heart and base.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your formulas live here as bottles, filled with their top, heart and base."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的配方以香水瓶的樣子排在這裡，裝著各自的前、中、後調。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的配方以香水瓶的样子排在这里，装着各自的前、中、后调。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処方はここにボトルとして並び、トップ・ミドル・ベースで満たされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처방은 탑, 미들, 베이스로 채워진 병 모양으로 여기에 놓입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Rezepte stehen hier als Flakons, gefüllt mit Kopf, Herz und Basis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos formules se rangent ici en flacons, remplis de leurs notes de tête, de cœur et de fond."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fórmulas viven aquí como frascos llenos de sus notas de salida, corazón y fondo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas fórmulas ficam aqui como frascos, cheios de notas de saída, coração e fundo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue formule stanno qui come flaconi, pieni di note di testa, cuore e fondo."
          }
        }
      }
    },
