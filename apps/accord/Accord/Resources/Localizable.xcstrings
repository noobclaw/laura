          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の原料を加えましょう。グラム・滴・% のどれでも、普段の単位で入力できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 원료를 추가하세요. 그램, 방울, 퍼센트 중 평소 쓰는 단위로 입력하면 됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deinen ersten Rohstoff hinzu. Gib Gramm, Tropfen oder Prozent ein, wie du eben wiegst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre première matière. Saisissez grammes, gouttes ou pourcentage, selon votre façon de peser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu primer material. Escribe gramos, gotas o porcentaje, como pesas tú."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione seu primeiro material. Digite gramas, gotas ou porcentagem, como você pesa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il tuo primo materiale. Scrivi grammi, gocce o percentuale, come pesi tu."
          }
        }
      }
