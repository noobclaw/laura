    "%@ off target. It will be recorded as weighed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ off target. It will be recorded as weighed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與目標相差 %@，會照實際秤量記錄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与目标相差 %@，会照实际称量记录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標から %@ ずれています。計量どおりに記録します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표와 %@ 차이가 납니다. 잰 그대로 기록됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ neben dem Ziel. Es wird so gespeichert, wie gewogen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écart de %@ avec la cible. La pesée réelle sera enregistrée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fuera del objetivo. Se registrará lo que pesaste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fora do alvo. Será registrado o que você pesou."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fuori obiettivo. Verrà registrato ciò che hai pesato."
          }
        }
      }
    },
