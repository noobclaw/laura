          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "追蹤每種原料的剩餘克數、每克成本、保存期限和供應商。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
