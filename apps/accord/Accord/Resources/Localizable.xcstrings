    "Volumes use typical densities (ethanol 0.79 g/ml, concentrate 0.95 g/ml). Weigh everything by mass.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumes use typical densities (ethanol 0.79 g/ml, concentrate 0.95 g/ml). Weigh everything by mass."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "容量以一般密度換算（乙醇 0.79 g/ml、濃縮液 0.95 g/ml）。全部請用重量秤。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容量以一般密度换算（乙醇 0.79 g/ml、浓缩液 0.95 g/ml）。全部请用重量称。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "容量は一般的な密度で換算しています（エタノール 0.79 g/ml、コンセントレート 0.95 g/ml）。すべて重さで量ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용량은 일반 밀도로 환산합니다 (에탄올 0.79 g/ml, 농축액 0.95 g/ml). 모두 무게로 재세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen mit typischen Dichten (Ethanol 0,79 g/ml, Konzentrat 0,95 g/ml). Wieg alles nach Masse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les volumes utilisent des densités types (éthanol 0,79 g/ml, concentré 0,95 g/ml). Pesez tout en masse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los volúmenes usan densidades típicas (etanol 0,79 g/ml, concentrado 0,95 g/ml). Pesa todo por masa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os volumes usam densidades típicas (etanol 0,79 g/ml, concentrado 0,95 g/ml). Pese tudo por massa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I volumi usano densità tipiche (etanolo 0,79 g/ml, concentrato 0,95 g/ml). Pesa tutto in massa."
          }
        }
      }
    },
