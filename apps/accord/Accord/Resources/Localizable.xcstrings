    "Save what you actually weighed, rate it as it matures and get a reminder on day 7, 14 and 28.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save what you actually weighed, rate it as it matures and get a reminder on day 7, 14 and 28."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記下實際秤的量，隨熟成評分，並在第 7、14、28 天收到提醒。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记下实际称的量，随熟成评分，并在第 7、14、28 天收到提醒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際に量った量を残し、熟成に合わせて評価し、7・14・28 日目に通知を受け取れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제로 잰 양을 저장하고, 숙성에 따라 평가하고, 7·14·28일째에 알림을 받으세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere, was du wirklich gewogen hast, bewerte die Reifung und werde an Tag 7, 14 und 28 erinnert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez ce que vous avez vraiment pesé, notez la maturation et recevez un rappel aux jours 7, 14 et 28."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda lo que pesaste de verdad, valóralo mientras madura y recibe un aviso los días 7, 14 y 28."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve o que você realmente pesou, avalie durante a maturação e receba lembretes nos dias 7, 14 e 28."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva ciò che hai davvero pesato, valutalo mentre matura e ricevi un promemoria ai giorni 7, 14 e 28."
          }
        }
      }
    },
