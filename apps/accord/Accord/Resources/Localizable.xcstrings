    "Add a maximum % to any material in Materials (from your supplier’s documents) and Accord checks every formula against it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a maximum % to any material in Materials (from your supplier’s documents) and Accord checks every formula against it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「原料」為任何原料填上最高 %（依供應商文件），Accord 就會檢查每個配方。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“原料”为任何原料填上最高 %（依供应商文件），Accord 就会检查每个配方。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「原料」で上限 %（仕入れ先の資料から）を入れると、Accord がすべての処方をチェックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'원료'에서 원료마다 최대 %(공급업체 문서 기준)를 입력하면 Accord가 모든 처방을 확인합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag unter Rohstoffe einen Höchstwert in % ein (aus den Unterlagen deines Lieferanten) und Accord prüft jedes Rezept dagegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un % maximum à une matière dans Matières (d’après les documents du fournisseur) et Accord vérifie chaque formule."
          }
        },
        "es": {
          "stringUnit": {
