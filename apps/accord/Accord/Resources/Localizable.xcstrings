    "Weigh the solution; Accord counts only the active material in the analysis.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weigh the solution; Accord counts only the active material in the analysis."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "秤的是稀釋液；分析時 Accord 只計算有效成分。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "称的是稀释液；分析时 Accord 只计算有效成分。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "量るのは希釈液です。分析では Accord が有効成分だけを数えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "희석액을 재세요. 분석에서는 Accord가 유효 성분만 계산합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieg die Lösung; Accord zählt in der Analyse nur den Wirkstoff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesez la solution ; Accord ne compte que la matière active dans l’analyse."
          }
