    "%lld formulas use it as a base; those lines will show “Missing material”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld formulas use it as a base; those lines will show “Missing material”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 個配方把它當基底；那些行會顯示「缺少原料」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 个配方把它当基底；那些行会显示“缺少原料”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件の処方がベースとして使っています。その行は「原料がありません」と表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 처방이 베이스로 사용 중입니다. 해당 줄은 '원료 없음'으로 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Rezepte nutzen es als Basis; diese Zeilen zeigen dann „Fehlender Rohstoff“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld formules l’utilisent comme base ; ces lignes afficheront « Matière manquante »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fórmulas lo usan como base; esas líneas mostrarán «Material que falta»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
