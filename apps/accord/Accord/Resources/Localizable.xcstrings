    "Perfume changes as it rests. Smell each batch on the days you planned and write down what moved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfume changes as it rests. Smell each batch on the days you planned and write down what moved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "香水靜置時會變化。在預定的日子聞每個批次，寫下有什麼不同。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "香水静置时会变化。在预定的日子闻每个批次，写下有什么不同。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "香水は寝かせると変わります。予定の日に各バッチを嗅いで、変化を書き留めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "향수는 숙성되며 변합니다. 정한 날에 배치를 맡아 보고 달라진 점을 적어 두세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Parfum verändert sich beim Ruhen. Riech an den geplanten Tagen an jeder Charge und notiere, was sich bewegt hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un parfum évolue au repos. Sentez chaque lot aux jours prévus et notez ce qui a bougé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfume cambia mientras reposa. Huele cada lote los días previstos y anota qué cambió."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfume muda enquanto descansa. Cheire cada lote nos dias planejados e anote o que mudou."
          }
        },
