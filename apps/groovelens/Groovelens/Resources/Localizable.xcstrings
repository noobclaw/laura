    "Tap + and pick a song, a rehearsal video, or record your band. Charts appear here.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點 + 選一首歌、一段排練影片，或直接錄下你的樂團。鼓譜會出現在這裡。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点 + 选一首歌、一段排练视频，或直接录下你的乐队。鼓谱会出现在这里。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "+ をタップして曲やリハーサル動画を選ぶか、バンドを録音しましょう。譜面はここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "+를 눌러 곡이나 합주 영상을 고르거나 밴드를 녹음하세요. 악보가 여기에 나타납니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf + und wähle einen Song, ein Probenvideo oder nimm deine Band auf. Deine Noten erscheinen hier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche + et choisis un morceau, une vidéo de répétition, ou enregistre ton groupe. Tes partitions s’affichent ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca + y elige una canción, un vídeo de ensayo o graba a tu banda. Las partituras aparecen aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em + e escolha uma música, um vídeo de ensaio ou grave sua banda. As partituras aparecem aqui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca + e scegli un brano, un video delle prove o registra la tua band. Gli spartiti compaiono qui."
          }
        }
      }
    },
