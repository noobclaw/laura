    "Pulled from your songs. Each drill loops the bar before the fill, then the fill.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從你的歌裡挑出來。每次練習先循環過門前一小節，再接過門。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你的歌里挑出来。每次练习先循环过门前一小节，再接过门。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの曲から抜き出しました。フィルの前の小節からループします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 곡에서 뽑았습니다. 필인 앞 마디부터 이어서 반복합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus deinen Songs. Jede Übung loopt den Takt vor dem Fill und dann den Fill."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirés de tes morceaux. Chaque exercice boucle la mesure avant le break, puis le break."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sacados de tus canciones. Cada práctica repite el compás anterior y luego el fill."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiradas das suas músicas. Cada treino repete o compasso anterior e depois a virada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Presi dai tuoi brani. Ogni esercizio ripete la battuta prima del fill, poi il fill."
          }
        }
      }
    },
    "Put your iPhone near the band, not on the kit. Up to 10 minutes.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把 iPhone 放在樂團附近，不要放在鼓上。最長 10 分鐘。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 iPhone 放在乐队附近，不要放在鼓上。最长 10 分钟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone はドラムの上ではなくバンドの近くに置いてください。最長 10 分。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone을 드럼 위가 아니라 밴드 근처에 두세요. 최대 10분."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg dein iPhone in die Nähe der Band, nicht aufs Schlagzeug. Bis zu 10 Minuten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose ton iPhone près du groupe, pas sur la batterie. Jusqu’à 10 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja el iPhone cerca de la banda, no sobre la batería. Hasta 10 minutos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o iPhone perto da banda, não na bateria. Até 10 minutos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti l’iPhone vicino alla band, non sulla batteria. Fino a 10 minuti."
          }
        }
