    "Start slow, climb 5% after every clean loop.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從慢速開始，每次乾淨通過就加快 5%。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从慢速开始，每次干净通过就加快 5%。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくり始めて、ミスなく回るたびに 5% ずつ速く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "느리게 시작해 깔끔하게 한 바퀴 돌 때마다 5%씩 빨라집니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsam starten, nach jedem sauberen Durchlauf 5 % schneller."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence lentement, +5 % après chaque boucle propre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza despacio y sube un 5 % tras cada vuelta limpia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece devagar e suba 5% a cada volta limpa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parti piano e sali del 5% dopo ogni giro pulito."
          }
