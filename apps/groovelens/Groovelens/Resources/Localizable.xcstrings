    "Songs are analyzed on device. Nothing is uploaded, there are no accounts and no tracking.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歌曲在本機分析。不上傳任何東西，沒有帳號，也沒有追蹤。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "歌曲在本机分析。不上传任何东西，没有账号，也没有追踪。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲は端末内で解析します。アップロードもアカウントもトラッキングもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곡은 기기에서 분석됩니다. 업로드도, 계정도, 추적도 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Songs werden auf dem Gerät analysiert. Kein Upload, kein Konto, kein Tracking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les morceaux sont analysés sur l’appareil. Aucun envoi, aucun compte, aucun pistage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones se analizan en el dispositivo. Sin subidas, sin cuentas y sin rastreo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas são analisadas no aparelho. Nada é enviado, sem contas e sem rastreamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I brani vengono analizzati sul dispositivo. Nessun caricamento, nessun account, nessun tracciamento."
          }
        }
      }
    },
