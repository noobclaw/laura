    "Chart a song with some drum fills and they’ll collect here automatically.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "扒一首有鼓過門的歌，過門就會自動收集到這裡。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扒一首有鼓过门的歌，过门就会自动收集到这里。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルインのある曲を譜面にすると、ここに自動で集まります。"
          }
        },
