    "Drum separation uses harmonic–percussive median filtering (Fitzgerald, 2010). Beat tracking follows Ellis (2007).": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鼓聲分離使用諧波／打擊中值濾波（Fitzgerald，2010），節拍追蹤採用 Ellis（2007）的方法。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼓声分离使用谐波／打击中值滤波（Fitzgerald，2010），节拍追踪采用 Ellis（2007）的方法。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラム分離には調波／打楽器メディアンフィルタ（Fitzgerald, 2010）を、ビート追跡には Ellis（2007）の手法を使っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드럼 분리는 하모닉–퍼커시브 중앙값 필터(Fitzgerald, 2010)를, 비트 추적은 Ellis(2007) 방식을 사용합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Drum-Trennung nutzt harmonisch-perkussive Medianfilterung (Fitzgerald, 2010), das Beat-Tracking folgt Ellis (2007)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La séparation de la batterie utilise un filtrage médian harmonique-percussif (Fitzgerald, 2010) ; le suivi du tempo suit Ellis (2007)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La separación de batería usa filtrado de mediana armónico-percusivo (Fitzgerald, 2010). El seguimiento del pulso sigue a Ellis (2007)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A separação da bateria usa filtragem de mediana harmônico-percussiva (Fitzgerald, 2010). O rastreamento do pulso segue Ellis (2007)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La separazione della batteria usa il filtraggio mediano armonico-percussivo (Fitzgerald, 2010); il tracciamento del beat segue Ellis (2007)."
          }
        }
      }
    },
