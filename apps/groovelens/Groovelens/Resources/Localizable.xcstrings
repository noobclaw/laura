    "Payment is charged to your Apple Account. Family Sharing supported.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "款項會向你的 Apple 帳號收取，支援家人共享。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "款项会向你的 Apple 账户收取，支持家人共享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お支払いは Apple アカウントに請求されます。ファミリー共有に対応。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제는 Apple 계정으로 청구됩니다. 가족 공유를 지원합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung erfolgt über deinen Apple Account. Familienfreigabe wird unterstützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement est débité sur ton compte Apple. Partage familial pris en charge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se carga a tu cuenta de Apple. Compatible con En familia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento é cobrado na sua Conta Apple. Compatível com Compartilhamento Familiar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento viene addebitato sul tuo Account Apple. Supporta In famiglia."
          }
        }
      }
    },
    "Pick a drum, then tap the staff to add or remove a hit.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先選一種鼓，再點譜表新增或移除一擊。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先选一种鼓，再点谱表添加或移除一击。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラムを選んでから譜表をタップして打音を追加・削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드럼을 고른 뒤 보표를 탭해 타격을 추가하거나 지우세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Trommel und tippe auf das Notensystem, um einen Schlag hinzuzufügen oder zu entfernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un élément, puis touche la portée pour ajouter ou retirer une frappe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un tambor y toca el pentagrama para añadir o quitar un golpe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma peça e toque na pauta para adicionar ou remover uma batida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un tamburo, poi tocca il pentagramma per aggiungere o togliere un colpo."
          }
        }
      }
    },
    "Pick any of 10 languages in iOS Settings.": {
      "localizations": {
        "zh-Hant": {
