    "Automatic transcription can miss or mislabel hits. Use the chart editor to fix anything that looks wrong.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動扒譜可能漏掉或認錯某些擊打，看起來不對的地方可以用鼓譜編輯器修正。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动扒谱可能漏掉或认错某些击打，看起来不对的地方可以用鼓谱编辑器修正。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動採譜では打音を見落としたり取り違えたりすることがあります。おかしな箇所は譜面エディタで直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 채보는 일부 타격을 놓치거나 잘못 인식할 수 있습니다. 이상한 부분은 악보 편집기로 고치세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Transkription kann Schläge übersehen oder falsch zuordnen. Korrigiere sie im Noteneditor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription automatique peut manquer ou mal identifier des frappes. Corrige-les dans l’éditeur de partition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción automática puede omitir o confundir golpes. Corrige lo que veas mal en el editor de partitura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição automática pode perder ou confundir batidas. Corrija o que parecer errado no editor de partitura."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione automatica può perdere o confondere alcuni colpi. Correggili nell’editor dello spartito."
          }
        }
      }
    },
