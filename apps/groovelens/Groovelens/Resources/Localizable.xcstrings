    "Kit mode needs the microphone to hear your drums. You can turn it on in Settings › Groovelens.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "真鼓模式需要麥克風才能聽到你的鼓聲。可以到「設定 › Groovelens」開啟。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真鼓模式需要麦克风才能听到你的鼓声。可以到“设置 › Groovelens”开启。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キットモードではマイクでドラムの音を聴きます。「設定 › Groovelens」でオンにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키트 모드는 마이크로 드럼 소리를 들어야 합니다. 설정 › Groovelens에서 켤 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kit-Modus braucht das Mikrofon, um deine Drums zu hören. Aktiviere es unter Einstellungen › Groovelens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode Batterie a besoin du micro pour entendre ta batterie. Active-le dans Réglages › Groovelens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo Batería necesita el micrófono para oír tu batería. Actívalo en Ajustes › Groovelens."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo Bateria precisa do microfone para ouvir sua bateria. Ative em Ajustes › Groovelens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità Batteria richiede il microfono per sentire la tua batteria. Attivalo in Impostazioni › Groovelens."
          }
        }
      }
    },
