    "Play your real drums — the mic scores every hit.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打你的真鼓，麥克風為每一擊打分。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打你的真鼓，麦克风为每一击打分。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本物のドラムを叩けば、マイクが一打ごとに採点します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 드럼을 치면 마이크가 모든 타격을 채점합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel dein echtes Schlagzeug – das Mikro bewertet jeden Schlag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue sur ta vraie batterie : le micro note chaque frappe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca tu batería real: el micro puntúa cada golpe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque sua bateria de verdade: o microfone avalia cada batida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona la tua vera batteria: il microfono valuta ogni colpo."
          }
        }
      }
    },
    "Play your real kit — the mic scores you": {
      "localizations": {
        "zh-Hant": {
