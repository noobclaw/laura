    },
    "Use headphones — otherwise the mic hears the backing track too.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請戴耳機，不然麥克風也會收到伴奏。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请戴耳机，不然麦克风也会收到伴奏。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘッドホンを使ってください。使わないとマイクが伴奏も拾います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헤드폰을 쓰세요. 그렇지 않으면 마이크가 반주도 듣습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Kopfhörer – sonst hört das Mikro auch die Begleitspur."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise un casque, sinon le micro entend aussi l’accompagnement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa auriculares; si no, el micro también oye la pista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use fones; senão o microfone também capta o acompanhamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa le cuffie, altrimenti il microfono sente anche la base."
          }
        }
      }
    },
    "Use the headphones or speaker you play with. Tap the big pad exactly on each click.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你平常演奏時用的耳機或喇叭，跟著每一聲點擊敲大圓鈕。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你平常演奏时用的耳机或扬声器，跟着每一声点击敲大圆钮。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "演奏で使うヘッドホンかスピーカーで、クリックに合わせて大きなパッドをタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연주할 때 쓰는 헤드폰이나 스피커로, 클릭에 정확히 맞춰 큰 패드를 탭하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze die Kopfhörer oder Lautsprecher, mit denen du spielst. Tippe genau auf jeden Klick auf das große Pad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le casque ou l’enceinte avec lesquels tu joues. Touche le grand pad pile sur chaque clic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa los auriculares o el altavoz con que tocas. Toca el pad grande justo en cada clic."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use os fones ou o alto-falante com que você toca. Toque o pad grande bem em cada clique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa le cuffie o l’altoparlante con cui suoni. Tocca il pad grande esattamente su ogni click."
          }
        }
      }
    },
