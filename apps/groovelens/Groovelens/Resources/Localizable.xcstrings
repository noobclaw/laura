    "Unlimited songs, Kit mode, speed trainer, every fill, exports and all stages.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無限歌曲、真鼓模式、速度訓練、全部過門、匯出與所有舞台。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无限歌曲、真鼓模式、速度训练、全部过门、导出与所有舞台。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲数無制限、キットモード、スピードトレーナー、全フィル、書き出し、全ステージ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곡 무제한, 키트 모드, 속도 트레이너, 모든 필인, 내보내기, 모든 스테이지."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbegrenzt Songs, Kit-Modus, Tempo-Trainer, alle Fills, Export und alle Bühnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Morceaux illimités, mode Batterie, entraîneur de tempo, tous les breaks, exports et toutes les scènes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Canciones ilimitadas, modo Batería, entrenador de velocidad, todos los fills, exportación y todos los escenarios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Músicas ilimitadas, modo Bateria, treino de velocidade, todas as viradas, exportação e todos os palcos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Brani illimitati, modalità Batteria, allenatore di velocità, tutti i fill, esportazione e tutti i palchi."
          }
        }
      }
    },
