    "You tap a little after the click. We’ll correct for it.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你敲得比點擊聲稍晚一點，我們會幫你修正。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你敲得比点击声稍晚一点，我们会帮你修正。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックより少し遅れてタップしています。こちらで補正します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭보다 조금 늦게 탭하고 있어요. 자동으로 보정합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tippst etwas nach dem Klick. Wir gleichen das aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tapes un peu après le clic. On corrige pour toi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocas un poco después del clic. Lo corregiremos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você toca um pouco depois do clique. Vamos corrigir isso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocchi un po’ dopo il click. Lo correggiamo noi."
          }
        }
      }
    },
