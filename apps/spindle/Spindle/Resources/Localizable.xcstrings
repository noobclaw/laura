    "Spindle can’t save to Photos. Allow it in Settings › Privacy › Photos, or use Share instead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle can’t save to Photos. Allow it in Settings › Privacy › Photos, or use Share instead."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle 無法存到照片。請到「設定 › 隱私權 › 照片」允許，或改用「分享」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle 无法存到照片。请到“设置 › 隐私 › 照片”允许，或改用“分享”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle は写真に保存できません。「設定 › プライバシー › 写真」で許可するか、「共有」を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle이 사진에 저장할 수 없습니다. 설정 › 개인정보 보호 › 사진에서 허용하거나 공유를 사용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle kann nicht in Fotos sichern. Erlaube es unter Einstellungen › Datenschutz › Fotos oder nutze „Teilen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle ne peut pas enregistrer dans Photos. Autorisez-le dans Réglages › Confidentialité › Photos, ou utilisez Partager."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle no puede guardar en Fotos. Permítelo en Ajustes › Privacidad › Fotos o usa Compartir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Spindle não pode salvar em Fotos. Permita em Ajustes › Privacidade › Fotos ou use Compartilhar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle non può salvare in Foto. Consentilo in Impostazioni › Privacy › Foto, oppure usa Condividi."
          }
        }
      }
    },
    "Spindle collects no data. Your server passwords stay in this iPhone’s Keychain and your music goes straight from your server to you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle collects no data. Your server passwords stay in this iPhone’s Keychain and your music goes straight from your server to you."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle 不收集任何資料。伺服器密碼只存在這支 iPhone 的鑰匙圈，音樂直接從你的伺服器傳到你手上。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle 不收集任何数据。服务器密码只存在这台 iPhone 的钥匙串，音乐直接从你的服务器传到你手上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle はデータを一切集めません。サーバのパスワードはこの iPhone のキーチェーンにだけ保存され、音楽はサーバから直接届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle은 어떤 데이터도 수집하지 않습니다. 서버 암호는 이 iPhone의 키체인에만 있고, 음악은 서버에서 바로 전달됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle sammelt keine Daten. Server-Passwörter bleiben im Schlüsselbund dieses iPhone, die Musik kommt direkt von deinem Server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle ne collecte aucune donnée. Vos mots de passe restent dans le trousseau de cet iPhone et la musique arrive directement de votre serveur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle no recopila datos. Las contraseñas del servidor se quedan en el llavero de este iPhone y la música llega directo desde tu servidor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Spindle não coleta dados. As senhas do servidor ficam nas Chaves deste iPhone e a música vai direto do seu servidor até você."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle non raccoglie dati. Le password del server restano nel portachiavi di questo iPhone e la musica arriva direttamente dal tuo server."
          }
        }
      }
    },
    "Spindle isn’t allowed to reach your home network. Turn on Local Network for Spindle in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle isn’t allowed to reach your home network. Turn on Local Network for Spindle in Settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle 沒有權限存取家用網路，請到「設定」開啟 Spindle 的「區域網路」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle 没有权限访问家庭网络，请到“设置”打开 Spindle 的“本地网络”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle はホームネットワークにアクセスできません。「設定」で Spindle の「ローカルネットワーク」をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle이 홈 네트워크에 접근할 수 없습니다. 설정에서 Spindle의 로컬 네트워크를 켜세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle darf dein Heimnetz nicht erreichen. Aktiviere „Lokales Netzwerk“ für Spindle in den Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle n’a pas accès à votre réseau local. Activez Réseau local pour Spindle dans Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle no puede acceder a tu red local. Activa Red local para Spindle en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Spindle não pode acessar sua rede local. Ative Rede Local para o Spindle em Ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle non può accedere alla rete locale. Attiva Rete locale per Spindle in Impostazioni."
          }
        }
      }
    },
