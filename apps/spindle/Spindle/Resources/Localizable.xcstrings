    "Search looks through every source at once, including songs you’ve downloaded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search looks through every source at once, including songs you’ve downloaded."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋會同時查找所有來源，包括已下載的歌曲。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索会同时查找所有来源，包括已下载的歌曲。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのソースを一度に検索します。ダウンロード済みの曲も含みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 소스를 한 번에 검색합니다. 다운로드한 노래도 포함됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche durchsucht alle Quellen auf einmal, auch geladene Titel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche parcourt toutes les sources à la fois, y compris les morceaux téléchargés."
