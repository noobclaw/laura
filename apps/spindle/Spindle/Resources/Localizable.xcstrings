            "state": "translated",
            "value": "I tuoi 20 brani offline gratuiti sono esauriti"
          }
        }
      }
    },
    "Your library file couldn’t be read, so Spindle started fresh. Your music on the server is untouched.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library file couldn’t be read, so Spindle started fresh. Your music on the server is untouched."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取資料庫檔案，Spindle 已重新開始。伺服器上的音樂完全沒有變動。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取资料库文件，Spindle 已重新开始。服务器上的音乐完全没有变动。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリファイルを読めなかったため、Spindle は最初からやり直しました。サーバ上の音楽はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함 파일을 읽을 수 없어 Spindle을 새로 시작했습니다. 서버의 음악은 그대로입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mediathek-Datei war nicht lesbar, daher startet Spindle neu. Die Musik auf deinem Server bleibt unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de bibliothèque est illisible ; Spindle repart de zéro. La musique sur le serveur n’est pas touchée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el archivo de la biblioteca, así que Spindle empezó de nuevo. La música del servidor no se toca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o arquivo da biblioteca, então o Spindle começou do zero. As músicas no servidor não foram alteradas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il file della libreria, quindi Spindle è ripartito da zero. La musica sul server è intatta."
          }
        }
      }
    },
    "Your library file was damaged, so Spindle restored the last good copy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library file was damaged, so Spindle restored the last good copy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料庫檔案損壞了，Spindle 已還原上一份完好的副本。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料库文件损坏了，Spindle 已还原上一份完好的副本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリファイルが壊れていたため、Spindle は最後の正常なコピーを復元しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함 파일이 손상되어 Spindle이 마지막 정상 사본을 복원했습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mediathek-Datei war beschädigt, daher hat Spindle die letzte gute Kopie wiederhergestellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de bibliothèque était endommagé ; Spindle a restauré la dernière copie valide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de la biblioteca estaba dañado, así que Spindle restauró la última copia buena."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo da biblioteca estava danificado, então o Spindle restaurou a última cópia boa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file della libreria era danneggiato, quindi Spindle ha ripristinato l’ultima copia valida."
          }
        }
      }
    },
    "Your purchase is waiting for approval. Pro unlocks as soon as it’s approved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your purchase is waiting for approval. Pro unlocks as soon as it’s approved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的購買正在等待批准，批准後會立即解鎖 Pro。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的购买正在等待批准，批准后会立即解锁 Pro。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです。承認されるとすぐに Pro が解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구입이 승인 대기 중입니다. 승인되면 바로 Pro가 잠금 해제됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wartet auf Freigabe. Pro wird sofort danach freigeschaltet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat attend une approbation. Pro se débloque dès qu’il est approuvé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra espera aprobación. Pro se desbloquea en cuanto se apruebe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra aguarda aprovação. O Pro é liberado assim que aprovado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è in attesa di approvazione. Pro si sblocca appena approvato."
          }
        }
      }
    },
    "You’re offline. Downloaded songs still play.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re offline. Downloaded songs still play."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前離線，已下載的歌曲仍可播放。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前离线，已下载的歌曲仍可播放。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。ダウンロード済みの曲は再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인입니다. 다운로드한 노래는 재생됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. Geladene Titel spielen weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Les morceaux téléchargés restent lisibles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Las canciones descargadas siguen sonando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está offline. Músicas baixadas continuam tocando."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei offline. I brani scaricati si riproducono comunque."
          }
        }
      }
    },
