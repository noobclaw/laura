    "Add a WebDAV address from your NAS, or choose a folder in Files — including SMB servers you’ve connected there.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a WebDAV address from your NAS, or choose a folder in Files — including SMB servers you’ve connected there."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入 NAS 的 WebDAV 位址，或在「檔案」中選一個資料夾（包括你在那裡連上的 SMB 伺服器）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 NAS 的 WebDAV 地址，或在“文件”中选一个文件夹（包括你在那里连接的 SMB 服务器）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NAS の WebDAV アドレスを追加するか、「ファイル」でフォルダを選びます（そこで接続した SMB サーバも使えます）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NAS의 WebDAV 주소를 추가하거나 파일 앱에서 폴더를 고르세요. 거기서 연결한 SMB 서버도 됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine WebDAV-Adresse deines NAS hinzu oder wähle einen Ordner in „Dateien“ – auch dort verbundene SMB-Server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez l’adresse WebDAV de votre NAS ou choisissez un dossier dans Fichiers, y compris les serveurs SMB connectés là-bas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la dirección WebDAV de tu NAS o elige una carpeta en Archivos, incluidos los servidores SMB conectados ahí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o endereço WebDAV do seu NAS ou escolha uma pasta no app Arquivos, incluindo servidores SMB conectados lá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi l’indirizzo WebDAV del tuo NAS o scegli una cartella in File, anche i server SMB collegati lì."
          }
        }
      }
    },
