    "Your 20 free offline songs are used": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your 20 free offline songs are used"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "20 首免費離線歌曲已用完"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "20 首免费离线歌曲已用完"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料のオフライン 20 曲を使い切りました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 오프라인 20곡을 다 썼습니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine 20 kostenlosen Offline-Titel sind belegt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos 20 morceaux hors ligne gratuits sont utilisés"
          }
        },
        "es": {
          "stringUnit": {
