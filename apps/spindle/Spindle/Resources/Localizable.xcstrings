    "That folder doesn’t exist on the server. Check the path after the port.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That folder doesn’t exist on the server. Check the path after the port."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器上沒有這個資料夾，請檢查埠號後面的路徑。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器上没有这个文件夹，请检查端口后面的路径。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのフォルダはサーバにありません。ポートの後のパスを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 그 폴더가 없습니다. 포트 뒤의 경로를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Ordner gibt es auf dem Server nicht. Prüfe den Pfad nach dem Port."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier n’existe pas sur le serveur. Vérifiez le chemin après le port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa carpeta no existe en el servidor. Revisa la ruta después del puerto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa pasta não existe no servidor. Confira o caminho depois da porta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella non esiste sul server. Controlla il percorso dopo la porta."
          }
        }
      }
    },
    "The App Store couldn’t verify this purchase.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store couldn’t verify this purchase."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 無法驗證這筆購買。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 无法验证这笔购买。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store がこの購入を確認できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 이 구입을 확인할 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store konnte diesen Kauf nicht bestätigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store n’a pas pu vérifier cet achat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store no pudo verificar esta compra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não conseguiu verificar esta compra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store non ha potuto verificare questo acquisto."
          }
        }
      }
    },
    "The App Store isn’t reachable right now. Check your connection and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store isn’t reachable right now. Check your connection and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法連上 App Store，請檢查網路後再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法连接 App Store，请检查网络后再试一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store に接続できません。通信状況を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 App Store에 연결할 수 없습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store ist gerade nicht erreichbar. Prüfe die Verbindung und versuch es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store est injoignable pour le moment. Vérifiez votre connexion et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con el App Store ahora. Revisa la conexión e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não está acessível agora. Confira sua conexão e tente de novo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store non è raggiungibile ora. Controlla la connessione e riprova."
          }
        }
      }
    },
    "The purchase didn’t go through: %@": {
