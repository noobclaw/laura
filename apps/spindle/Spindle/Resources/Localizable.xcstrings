          }
        }
      }
    },
    "The server answered with an error (%lld). Try again in a moment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server answered with an error (%lld). Try again in a moment."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器回傳錯誤（%lld），請稍後再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器返回错误（%lld），请稍后再试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバがエラーを返しました（%lld）。少し待ってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 오류(%lld)를 반환했습니다. 잠시 후 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server meldet einen Fehler (%lld). Versuch es gleich noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a renvoyé une erreur (%lld). Réessayez dans un instant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor respondió con un error (%lld). Inténtalo de nuevo en un momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor respondeu com um erro (%lld). Tente de novo daqui a pouco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha risposto con un errore (%lld). Riprova tra poco."
          }
        }
      }
    },
    "The server didn’t answer. Check that your iPhone and the NAS are on the same network.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server didn’t answer. Check that your iPhone and the NAS are on the same network."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器沒有回應，請確認 iPhone 和 NAS 在同一個網路。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器没有响应，请确认 iPhone 和 NAS 在同一个网络。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバが応答しません。iPhone と NAS が同じネットワークにあるか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 응답하지 않습니다. iPhone과 NAS가 같은 네트워크에 있는지 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server antwortet nicht. Sind iPhone und NAS im selben Netzwerk?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ne répond pas. Vérifiez que l’iPhone et le NAS sont sur le même réseau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no responde. Comprueba que el iPhone y el NAS estén en la misma red."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não respondeu. Confira se o iPhone e o NAS estão na mesma rede."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non risponde. Verifica che iPhone e NAS siano sulla stessa rete."
          }
        }
      }
    },
    "The server rejected the user name or password.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected the user name or password."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器拒絕了使用者名稱或密碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了用户名或密码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバがユーザ名またはパスワードを拒否しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 사용자 이름 또는 암호를 거부했습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat Benutzername oder Passwort abgelehnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a refusé le nom d’utilisateur ou le mot de passe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó el usuario o la contraseña."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor recusou o usuário ou a senha."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha rifiutato nome utente o password."
          }
        }
      }
    },
    "The server’s security certificate isn’t trusted. Use http on your home network, or install the certificate on this iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server’s security certificate isn’t trusted. Use http on your home network, or install the certificate on this iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器的安全憑證不受信任。在家用網路請用 http，或在這支 iPhone 安裝憑證。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器的安全证书不受信任。在家庭网络请用 http，或在这台 iPhone 安装证书。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバの証明書が信頼されていません。家のネットワークでは http を使うか、この iPhone に証明書を入れてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버의 보안 인증서를 신뢰할 수 없습니다. 집 네트워크에서는 http를 쓰거나 이 iPhone에 인증서를 설치하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem Zertifikat des Servers wird nicht vertraut. Nutze zu Hause http oder installiere das Zertifikat auf diesem iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat du serveur n’est pas approuvé. Utilisez http sur votre réseau domestique ou installez le certificat sur cet iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El certificado del servidor no es de confianza. Usa http en tu red de casa o instala el certificado en este iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O certificado do servidor não é confiável. Use http na rede de casa ou instale o certificado neste iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il certificato del server non è attendibile. Usa http sulla rete di casa o installa il certificato su questo iPhone."
          }
        }
      }
    },
    "This account can’t read that folder. Check its permissions on the NAS.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account can’t read that folder. Check its permissions on the NAS."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個帳號無法讀取那個資料夾，請到 NAS 上檢查權限。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个账号无法读取那个文件夹，请到 NAS 上检查权限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントはそのフォルダを読めません。NAS で権限を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 그 폴더를 읽을 수 없습니다. NAS에서 권한을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto darf den Ordner nicht lesen. Prüfe die Rechte auf dem NAS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte ne peut pas lire ce dossier. Vérifiez ses droits sur le NAS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta no puede leer esa carpeta. Revisa sus permisos en el NAS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta não consegue ler essa pasta. Confira as permissões no NAS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account non può leggere la cartella. Controlla i permessi sul NAS."
          }
        }
      }
    },
    "This address doesn’t look right. Try something like http://192.168.1.20:5005/music": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This address doesn’t look right. Try something like http://192.168.1.20:5005/music"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個位址看起來不對。試試 http://192.168.1.20:5005/music 這種格式"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个地址看起来不对。试试 http://192.168.1.20:5005/music 这种格式"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスが正しくないようです。http://192.168.1.20:5005/music のように入力してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소가 올바르지 않은 것 같습니다. http://192.168.1.20:5005/music 처럼 입력해 보세요"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Adresse sieht falsch aus. Versuch es etwa mit http://192.168.1.20:5005/music"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse semble incorrecte. Essayez par exemple http://192.168.1.20:5005/music"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dirección no parece correcta. Prueba algo como http://192.168.1.20:5005/music"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este endereço não parece certo. Tente algo como http://192.168.1.20:5005/music"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo indirizzo non sembra corretto. Prova per esempio http://192.168.1.20:5005/music"
          }
        }
      }
    },
    "This address isn’t a WebDAV server. On Synology, turn on WebDAV Server and use its port (5005, or 5006 for HTTPS).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This address isn’t a WebDAV server. On Synology, turn on WebDAV Server and use its port (5005, or 5006 for HTTPS)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個位址不是 WebDAV 伺服器。Synology 請開啟 WebDAV Server 並使用它的埠（5005，HTTPS 用 5006）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个地址不是 WebDAV 服务器。Synology 请开启 WebDAV Server 并使用它的端口（5005，HTTPS 用 5006）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスは WebDAV サーバではありません。Synology では WebDAV Server を有効にし、そのポート（5005、HTTPS は 5006）を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주소는 WebDAV 서버가 아닙니다. Synology에서는 WebDAV Server를 켜고 그 포트(5005, HTTPS는 5006)를 쓰세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter dieser Adresse läuft kein WebDAV. Aktiviere bei Synology WebDAV Server und nutze dessen Port (5005 oder 5006 für HTTPS)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse n’est pas un serveur WebDAV. Sur Synology, activez WebDAV Server et utilisez son port (5005, ou 5006 en HTTPS)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dirección no es un servidor WebDAV. En Synology, activa WebDAV Server y usa su puerto (5005, o 5006 para HTTPS)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este endereço não é um servidor WebDAV. No Synology, ative o WebDAV Server e use a porta dele (5005, ou 5006 para HTTPS)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo indirizzo non è un server WebDAV. Su Synology attiva WebDAV Server e usa la sua porta (5005, o 5006 per HTTPS)."
          }
        }
      }
    },
    "This folder can’t be opened anymore. Remove the source and choose the folder again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder can’t be opened anymore. Remove the source and choose the folder again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個資料夾已無法開啟，請移除來源後重新選擇資料夾。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件夹已无法打开，请移除来源后重新选择文件夹。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダは開けなくなりました。ソースを削除してフォルダを選び直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더를 더 이상 열 수 없습니다. 소스를 삭제하고 폴더를 다시 고르세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner lässt sich nicht mehr öffnen. Entferne die Quelle und wähle den Ordner neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier ne s’ouvre plus. Supprimez la source et choisissez à nouveau le dossier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta ya no se puede abrir. Quita la fuente y vuelve a elegir la carpeta."
          }
        },
        "pt-BR": {
