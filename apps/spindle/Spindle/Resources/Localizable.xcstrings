    "Removing a source only removes it from Spindle. Nothing on your server or in Files is deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing a source only removes it from Spindle. Nothing on your server or in Files is deleted."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除來源只會從 Spindle 移除，伺服器或「檔案」中的內容都不會被刪除。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除来源只会从 Spindle 移除，服务器或“文件”中的内容都不会被删除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースを削除しても Spindle から外れるだけです。サーバや「ファイル」の中身は消えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스를 삭제해도 Spindle에서만 빠집니다. 서버나 파일 앱의 내용은 지워지지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Entfernen betrifft nur Spindle. Auf deinem Server oder in „Dateien“ wird nichts gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer une source ne la retire que de Spindle. Rien n’est effacé sur le serveur ni dans Fichiers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar una fuente solo la quita de Spindle. No se borra nada del servidor ni de Archivos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover uma fonte só a tira do Spindle. Nada é apagado no servidor ou no Arquivos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere una sorgente la toglie solo da Spindle. Niente viene eliminato dal server o da File."
          }
        }
      }
    },
