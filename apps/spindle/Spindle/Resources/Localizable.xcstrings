    "Free: one server or folder, plus the demo shelf. Pro: as many as you like.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free: one server or folder, plus the demo shelf. Pro: as many as you like."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費版：一個伺服器或資料夾，加上示範唱片架。Pro：想加幾個都行。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版：一个服务器或文件夹，加上示范唱片架。Pro：想加几个都行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料：サーバかフォルダ 1 つとデモの棚。Pro：いくつでも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료: 서버나 폴더 1개와 데모 선반. Pro: 원하는 만큼."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis: ein Server oder Ordner plus Demo-Regal. Pro: so viele du willst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit : un serveur ou dossier, plus l’étagère de démo. Pro : autant que vous voulez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis: un servidor o carpeta y el estante de demo. Pro: todos los que quieras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis: um servidor ou pasta, mais a estante de demonstração. Pro: quantos quiser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis: un server o una cartella, più lo scaffale demo. Pro: quanti ne vuoi."
          }
        }
      }
    },
