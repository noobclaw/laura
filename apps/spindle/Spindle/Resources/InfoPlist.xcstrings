    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle connects to the music server on your home network that you add as a source."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle 會連到你加入為來源、位於家用網路的音樂伺服器。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle 会连接你添加为来源、位于家庭网络的音乐服务器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle は、ソースとして追加したホームネットワーク上の音楽サーバに接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle은 소스로 추가한 홈 네트워크의 음악 서버에 연결합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle verbindet sich mit dem Musikserver in deinem Heimnetz, den du als Quelle hinzufügst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle se connecte au serveur de musique de votre réseau local que vous ajoutez comme source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle se conecta al servidor de música de tu red local que añadas como fuente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Spindle se conecta ao servidor de música da sua rede local que você adicionar como fonte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle si collega al server musicale della rete di casa che aggiungi come sorgente."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle saves the share card you create to your photo library."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle 會把你建立的分享卡片存到照片圖庫。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle 会把你创建的分享卡片存到照片图库。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle は作成した共有カードを写真ライブラリに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle은 만든 공유 카드를 사진 보관함에 저장합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle sichert die erstellte Teilen-Karte in deiner Fotomediathek."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle enregistre la carte de partage créée dans votre photothèque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle guarda la tarjeta para compartir en tu fototeca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Spindle salva o cartão de compartilhamento na sua fototeca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spindle salva la scheda di condivisione nella libreria foto."
          }
        }
      }
    }
  },
  "version": "1.0"
}