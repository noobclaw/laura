<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark mode on Android 12+: the night qualifier outranks -v31, so this
         file (not values-v31) is what the system picks; keep the splash
         background pinned to the same night colour here too. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
    </style>
</resources>
