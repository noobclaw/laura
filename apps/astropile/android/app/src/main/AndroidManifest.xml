<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Privacy guarantee: AstroPile never uses the network. If any bundled
         library declares INTERNET, strip it from the merged manifest so the
         store listing's "no network access" claim stays verifiable. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove"/>

    <!-- Import goes through the system Photo Picker, which needs no runtime
         permission, so no READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE is
         declared. Saving the finished stack (gal plugin) uses MediaStore on
         Android 10+; on Android 9 and below it still needs the legacy write
         permission. -->
    <!-- maxSdkVersion 29, not the 28 that camera_android_camerax declares:
         `gal` still needs the legacy write permission on API 29 because this
         app sets requestLegacyExternalStorage. Without tools:replace the two
         values collide and the manifest merger fails the build outright. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:replace="android:maxSdkVersion"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>

    <!-- In-app burst capture (M2): stills only, written to the app's own
         scratch folder. The camera plugin also declares RECORD_AUDIO for
         video recording, which this app never does (`enableAudio: false`);
         left in, the store page would tell users that an offline stacker
         wants their microphone. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <!-- Both flags, both optional: the camera is one way in, picking photos
         from the library is the other, and a device without a camera can use
         the app perfectly well. camera_android_camerax declares
         `android.hardware.camera.any` with no `android:required`, which
         defaults to TRUE — without the override below, Play would hide the
         app from camera-less devices. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="false"
        tools:replace="android:required"/>

    <!-- allowBackup=false: the only thing stored is the Pro flag and a
         counter. Letting them ride along in a cloud backup would contradict
         the "nothing leaves the phone" claim for no user benefit — a
         purchase comes back through Restore Purchases. -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- image_picker: the system photo picker. -->
        <intent>
            <action android:name="android.intent.action.GET_CONTENT"/>
            <data android:mimeType="image/*"/>
        </intent>
    </queries>
</manifest>
