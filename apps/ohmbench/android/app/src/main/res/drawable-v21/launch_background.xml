<?xml version="1.0" encoding="utf-8"?>
<!-- OhmBench launch: the dark bench with the resistor mark, matching the
     iOS launch screen and the app's first frame (no white flash). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/bench_background" />
    <item
        android:width="144dp"
        android:height="144dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
