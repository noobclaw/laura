{
  "name": "cats-hide-dogs-seek",
  "productName": "CatsHideDogsSeek",
  "version": "0.1.0",
  "description": "Hide-and-seek party game: cats paint themselves to hide, dogs seek.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "prepare-app": "node copy-web.js",
    "package": "node copy-web.js && electron-packager . CatsHideDogsSeek --out=dist --overwrite --asar --ignore=\"^/dist\" --ignore=\"^/copy-web.js\""
  },
  "devDependencies": {
    "electron": "33.2.0",
    "@electron/packager": "18.3.6"
  }
}
